{
  "description": "Talenthub — Vercel + AWS RDS. Master template: .env.vercel-rds.example. Set in Vercel Dashboard → Settings → Environment Variables → Production, then Redeploy.",
  "production_url": "https://talenthub-x.vercel.app",
  "master_template": ".env.vercel-rds.example",
  "already_in_vercel_json": [
    "USE_AWS_STACK",
    "USE_PRISMA_AUTH",
    "NEXT_PUBLIC_USE_AWS_STACK",
    "AUTO_RDS_SCHEMA",
    "AUTH_TRUST_HOST",
    "PREPINDIA_ADMIN_EMAIL",
    "NEXT_PUBLIC_SIGNUP_DISABLED"
  ],
  "required_in_dashboard": [
    {
      "name": "DATABASE_URL",
      "example": "postgresql://prepindia_admin:PASSWORD@prepindia-db.cxms2kg60760.ap-south-1.rds.amazonaws.com:5432/postgres?sslmode=require",
      "secret": true,
      "note": "No quotes. Use sslmode=require for AWS RDS."
    },
    {
      "name": "DIRECT_URL",
      "example": "postgresql://prepindia_admin:PASSWORD@prepindia-db.cxms2kg60760.ap-south-1.rds.amazonaws.com:5432/postgres?sslmode=require",
      "secret": true,
      "note": "Same host/user/password as DATABASE_URL."
    },
    {
      "name": "AUTH_SECRET",
      "example": "openssl rand -base64 32",
      "secret": true
    },
    {
      "name": "AUTH_URL",
      "example": "https://talenthub-x.vercel.app"
    },
    {
      "name": "NEXT_PUBLIC_APP_URL",
      "example": "https://talenthub-x.vercel.app"
    }
  ],
  "recommended_in_dashboard": [
    {
      "name": "PREPINDIA_ADMIN_PASSWORD",
      "example": "RCE_T&P",
      "secret": true
    },
    {
      "name": "RDS_SETUP_SECRET",
      "note": "Optional — protect /api/setup/rds after first run"
    }
  ],
  "remove_if_present": [
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY",
    "SUPABASE_SERVICE_ROLE_KEY",
    "POSTGRES_URL"
  ],
  "post_deploy_urls": [
    "/api/health",
    "/setup",
    "/auth/login/admin",
    "/auth/login/student",
    "/exams",
    "/placement/assessment"
  ]
}
