<svg xmlns="http://www.w3.org/2000/svg" width="1600" height="900" viewBox="0 0 1600 900" fill="none">
  <defs>
    <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#07111f"/>
      <stop offset="45%" stop-color="#0b1a2e"/>
      <stop offset="100%" stop-color="#10253d"/>
    </linearGradient>
    <linearGradient id="land" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#123049"/>
      <stop offset="100%" stop-color="#0a1c2c"/>
    </linearGradient>
    <linearGradient id="fog" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#22d3ee" stop-opacity="0.08"/>
      <stop offset="50%" stop-color="#6366f1" stop-opacity="0.05"/>
      <stop offset="100%" stop-color="#0ea5e9" stop-opacity="0"/>
    </linearGradient>
    <radialGradient id="glow" cx="50%" cy="40%" r="55%">
      <stop offset="0%" stop-color="#22d3ee" stop-opacity="0.18"/>
      <stop offset="100%" stop-color="#04101a" stop-opacity="0"/>
    </radialGradient>
  </defs>

  <rect width="1600" height="900" fill="url(#sky)"/>
  <rect width="1600" height="900" fill="url(#glow)"/>

  <!-- distant mountains -->
  <path d="M0 420 L180 260 L320 390 L480 220 L640 380 L820 200 L980 370 L1180 240 L1360 360 L1600 250 L1600 520 L0 520 Z" fill="#0d2236"/>
  <path d="M0 480 L220 320 L380 450 L560 300 L760 440 L960 280 L1160 430 L1380 310 L1600 420 L1600 560 L0 560 Z" fill="#123049" opacity="0.9"/>

  <!-- mid hills -->
  <path d="M0 560 C220 500 420 620 640 540 C860 460 1080 600 1300 520 C1450 470 1550 530 1600 500 L1600 700 L0 700 Z" fill="url(#land)"/>

  <!-- river -->
  <path d="M-40 620 C180 580 320 700 520 640 C720 580 880 720 1080 650 C1280 580 1460 690 1640 620" stroke="#22d3ee" stroke-opacity="0.28" stroke-width="18" fill="none" stroke-linecap="round"/>
  <path d="M-40 620 C180 580 320 700 520 640 C720 580 880 720 1080 650 C1280 580 1460 690 1640 620" stroke="#67e8f9" stroke-opacity="0.18" stroke-width="6" fill="none" stroke-linecap="round"/>

  <!-- forests / patches -->
  <ellipse cx="260" cy="610" rx="120" ry="48" fill="#0f2a3d" opacity="0.85"/>
  <ellipse cx="720" cy="650" rx="150" ry="55" fill="#0e2738" opacity="0.9"/>
  <ellipse cx="1180" cy="600" rx="140" ry="50" fill="#102f44" opacity="0.85"/>
  <ellipse cx="1450" cy="670" rx="110" ry="42" fill="#0d2436" opacity="0.8"/>

  <!-- path markers glow -->
  <circle cx="220" cy="580" r="10" fill="#22d3ee" fill-opacity="0.25"/>
  <circle cx="450" cy="610" r="10" fill="#22d3ee" fill-opacity="0.22"/>
  <circle cx="700" cy="560" r="10" fill="#22d3ee" fill-opacity="0.25"/>
  <circle cx="980" cy="600" r="10" fill="#22d3ee" fill-opacity="0.22"/>
  <circle cx="1260" cy="550" r="10" fill="#22d3ee" fill-opacity="0.25"/>
  <circle cx="1480" cy="590" r="10" fill="#fbbf24" fill-opacity="0.28"/>

  <!-- stars -->
  <g fill="#e2e8f0" fill-opacity="0.55">
    <circle cx="120" cy="80" r="1.5"/>
    <circle cx="280" cy="140" r="1.2"/>
    <circle cx="460" cy="60" r="1.4"/>
    <circle cx="640" cy="110" r="1.1"/>
    <circle cx="820" cy="50" r="1.6"/>
    <circle cx="1010" cy="95" r="1.2"/>
    <circle cx="1220" cy="70" r="1.5"/>
    <circle cx="1410" cy="120" r="1.1"/>
    <circle cx="1520" cy="45" r="1.3"/>
  </g>

  <rect width="1600" height="900" fill="url(#fog)"/>
  <rect width="1600" height="900" fill="url(#fog)" opacity="0.6"/>
</svg>
