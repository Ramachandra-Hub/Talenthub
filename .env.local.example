# =============================================================================
# Local development — copy to .env.local
# For Vercel Production, use .env.vercel-rds.example instead (master checklist).
# =============================================================================

USE_AWS_STACK=true
USE_PRISMA_AUTH=true
NEXT_PUBLIC_USE_AWS_STACK=true
AUTO_RDS_SCHEMA=true

# AWS RDS PostgreSQL — must be postgresql:// URL (NOT psql or "export RDSHOST=..." commands)
DATABASE_URL=postgresql://prepindia_admin:RAMACHANDRACOLLEGEOFENGINEERING@prepindia-db.cxms2kg60760.ap-south-1.rds.amazonaws.com:5432/postgres?sslmode=require
DIRECT_URL=postgresql://prepindia_admin:RAMACHANDRACOLLEGEOFENGINEERING@prepindia-db.cxms2kg60760.ap-south-1.rds.amazonaws.com:5432/postgres?sslmode=require
# Or set DATABASE_PASSWORD=... and RDS_HOST=... (see lib/postgres-url.ts)

# NextAuth
AUTH_SECRET=generate-with-openssl-rand-base64-32
# Local: use your dev port. Production (Vercel): set to https://your-app.vercel.app (not localhost).
AUTH_URL=http://localhost:3002
AUTH_TRUST_HOST=true
NEXT_PUBLIC_APP_URL=http://localhost:3002

# Admin login (defaults: admin@rce.ac.in / RCE_T&P — override in production if needed)
PREPINDIA_ADMIN_EMAIL=admin@rce.ac.in
PREPINDIA_ADMIN_PASSWORD=RCE_T&P
NEXT_PUBLIC_SIGNUP_DISABLED=true

# Optional: AWS S3 proctor uploads
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET=your-bucket
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Optional: Razorpay (payments disabled in app — 410)
# NEXT_PUBLIC_RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# Code execution (programming test)
# WANDBOX_API_URL=https://wandbox.org/api/compile.json
# PISTON_API_URL=https://your-piston-instance.example.com/api/v2/piston/execute

# Optional exam gateway proxy
# EXAM_GATEWAY_URL=http://127.0.0.1:4000
# EXAM_INTERNAL_API_TOKEN=dev-internal-token-change-me

# AI MCQ generation (optional)
# LOCAL_LLM_URL=http://127.0.0.1:11434
# OLLAMA_HOST=127.0.0.1
# HF_API_TOKEN=
# AI_MOCK=1
