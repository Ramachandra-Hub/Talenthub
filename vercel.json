{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "pnpm run build",
  "regions": ["bom1"],
  "env": {
    "USE_AWS_STACK": "true",
    "USE_PRISMA_AUTH": "true",
    "NEXT_PUBLIC_USE_AWS_STACK": "true",
    "AUTO_RDS_SCHEMA": "true",
    "AUTH_TRUST_HOST": "true",
    "PREPINDIA_ADMIN_EMAIL": "admin@rce.ac.in",
    "NEXT_PUBLIC_SIGNUP_DISABLED": "true"
  },
  "functions": {
    "app/api/setup/rds/route.ts": {
      "maxDuration": 120
    },
    "app/api/setup/seed-elevatex-sample/route.ts": {
      "maxDuration": 120
    },
    "app/api/setup/reset-elevatex-sample/route.ts": {
      "maxDuration": 120
    },
    "app/api/setup/reset-elevatex-attempts/route.ts": {
      "maxDuration": 120
    },
    "app/api/admin/test-reports/route.ts": {
      "maxDuration": 60
    },
    "app/api/admin/question-bank/route.ts": {
      "maxDuration": 60
    },
    "app/api/admin/exam-builder/create/route.ts": {
      "maxDuration": 120
    },
    "app/api/admin/cleanup-exams-keep-today/route.ts": {
      "maxDuration": 60
    },
    "app/api/exam/attempts/[attemptId]/autosave/route.ts": {
      "maxDuration": 30
    },
    "app/api/student/me/route.ts": {
      "maxDuration": 10
    },
    "app/api/student/signin/route.ts": {
      "maxDuration": 30
    },
    "app/api/student/test-attempts/route.ts": {
      "maxDuration": 60
    },
    "app/api/student/test-attempts/progress/route.ts": {
      "maxDuration": 30
    },
    "app/api/v2/coding/run/route.ts": {
      "maxDuration": 20
    },
    "app/api/student/test-attempts/[attemptId]/route.ts": {
      "maxDuration": 15
    },
    "app/api/v2/coding/run-batch/route.ts": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, must-revalidate" }
      ]
    }
  ]
}
