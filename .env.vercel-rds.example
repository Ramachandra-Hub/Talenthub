# =============================================================================
# Talenthub — Vercel Production environment (MASTER CHECKLIST)
# =============================================================================
#
# HOW TO USE
# 1. Open Vercel → your project → Settings → Environment Variables
# 2. Add each variable below for **Production** (and Preview if you test PRs)
# 3. Paste ONE line per value — NO surrounding quotes
# 4. Mark secrets (DATABASE_URL, DIRECT_URL, AUTH_SECRET, PREPINDIA_ADMIN_PASSWORD)
# 5. Click **Redeploy** after saving (env changes do not apply to old deployments)
#
# Verify locally before push:
#   copy this file to .env.local (or merge values), then:
#   node scripts/verify-vercel-aws-env.mjs
#
# Production app URL: https://talenthub-x.vercel.app
# Health check after deploy: https://talenthub-x.vercel.app/api/health
#
# =============================================================================
# A) AWS / app mode (also defaulted in vercel.json — safe to paste in Dashboard)
# =============================================================================
USE_AWS_STACK=true
USE_PRISMA_AUTH=true
NEXT_PUBLIC_USE_AWS_STACK=true
AUTO_RDS_SCHEMA=true
AUTH_TRUST_HOST=true
NEXT_PUBLIC_SIGNUP_DISABLED=true

# =============================================================================
# B) REQUIRED SECRETS & URLs (you must set these in Vercel)
# =============================================================================

# --- PostgreSQL (AWS RDS) — set real values only in Vercel Dashboard (never commit secrets) ---
# Host / user / password belong in secrets management, not in this example file.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# --- NextAuth / session signing ---
# Generate once: openssl rand -base64 32
# Must be the same value across all Production deploys (or all sessions break).
AUTH_SECRET=REPLACE_WITH_openssl_rand_base64_32

# --- Public URLs (must match your live Vercel domain, NOT localhost) ---
AUTH_URL=https://talenthub-x.vercel.app
NEXT_PUBLIC_APP_URL=https://talenthub-x.vercel.app

# =============================================================================
# C) ADMIN (also defaulted in vercel.json for email — set password in Dashboard)
# =============================================================================
PREPINDIA_ADMIN_EMAIL=admin@rce.ac.in
PREPINDIA_ADMIN_PASSWORD=replace-with-strong-password

# =============================================================================
# D) OPTIONAL
# =============================================================================

# Lock /api/setup/rds after first schema bootstrap (header: x-rds-setup-secret)
# RDS_SETUP_SECRET=your-random-setup-secret

# Proctor screenshot uploads to S3 (skip for basic MCQ / ElevateX trial)
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET=your-bucket
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Programming exam code execution (external Piston / Wandbox — not required for MCQ)
# PISTON_API_URL=https://your-piston-instance.example.com/api/v2/piston/execute
# WANDBOX_API_URL=https://wandbox.org/api/compile.json

# =============================================================================
# E) DO NOT SET ON VERCEL (remove if present — left over from old Supabase setup)
# =============================================================================
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# POSTGRES_URL=

# =============================================================================
# F) POST-DEPLOY CHECKLIST
# =============================================================================
# 1. https://talenthub-x.vercel.app/api/health  → database: ok
# 2. https://talenthub-x.vercel.app/auth/login/admin  → admin email + PREPINDIA_ADMIN_PASSWORD
# 3. https://talenthub-x.vercel.app/auth/login/student  → student login
# 4. First-time RDS tables: visit /setup or run scripts/apply-admin-setup.mjs locally
# 5. After env edits: Redeploy Production from Vercel Deployments tab
